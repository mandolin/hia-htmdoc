{
  "name": "@hia-doc/htmdoc-runner",
  "version": "0.1.0",
  "description": "Standalone HTMDoc project runner and CLI.",
  "license": "MIT",
  "keywords": [
    "documentation",
    "html",
    "cli",
    "htmdoc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mandolin/hia-htmdoc.git",
    "directory": "packages/htmdoc-runner"
  },
  "bugs": {
    "url": "https://github.com/mandolin/hia-htmdoc/issues"
  },
  "homepage": "https://github.com/mandolin/hia-htmdoc/tree/main/packages/htmdoc-runner#readme",
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./schemas/htmdoc-config-1.0.0.schema.json": "./src/schemas/htmdoc-config-1.0.0.schema.json",
