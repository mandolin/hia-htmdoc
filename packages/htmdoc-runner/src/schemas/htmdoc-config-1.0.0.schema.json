{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandolin.github.io/HIA-Documentation/schemas/htmdoc-config-1.0.0.schema.json",
  "title": "HTMDoc Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inputs"
  ],
  "properties": {
    "$schema": {
      "const": "https://mandolin.github.io/HIA-Documentation/schemas/htmdoc-config-1.0.0.schema.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^(?:[A-Za-z]:|/|\\\\|[A-Za-z][A-Za-z0-9+.-]*:)"
          },
          {
            "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
          }
        ]
      },
      "default": "."
    },
    "outputDirectory": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^(?:[A-Za-z]:|/|\\\\|[A-Za-z][A-Za-z0-9+.-]*:)"
          },
          {
            "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
          }
        ]
      },
      "default": "dist/htmdoc"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "kind": {
            "enum": [
              "html",
              "html-fragment",
              "html-template",
              "custom-elements-manifest"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "not": {
              "anyOf": [
                {
                  "pattern": "^(?:[A-Za-z]:|/|\\\\|[A-Za-z][A-Za-z0-9+.-]*:)"
                },
                {
                  "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
                }
              ]
            }
          },
          "language": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "emitDocSourceMap": {
          "type": "boolean"
        },
        "sourcesContentPolicy": {
          "enum": [
            "none",
            "reference",
            "embed"
          ]
        },
        "writeResultManifest": {
          "type": "boolean"
        }
      }
    },
    "profileIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    }
  }
}
